NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
WORKER_PORT=4001
LOG_LEVEL=debug

DATABASE_URL=postgresql://postgres:password@localhost:5432/event_ticketing?schema=public
DATABASE_URL_TEST=postgresql://postgres:password@localhost:5432/event_ticketing_test?schema=public

AUTH_ACCESS_TOKEN_SECRET=replace-with-long-random-secret
AUTH_REFRESH_TOKEN_SECRET=replace-with-long-random-secret
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=7d
COOKIE_DOMAIN=

PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=development-only-webhook-secret

EMAIL_PROVIDER=console
EMAIL_FROM="Gofest <no-reply@gofest.local>"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

STORAGE_PROVIDER=local
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=5

ORDER_RESERVATION_MINUTES=15
PLATFORM_FEE_TYPE=none
PLATFORM_FEE_VALUE=0
EVENT_REVIEW_REQUIRED=true

VITE_API_URL=/api/v1
